---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /**
   * What iOS Safari tints its status bar and toolbar with. See the meta below
   * — this is the one colour on the page that is not painted by the page.
   */
  themeColor?: string;
}

const {
  title = "Sobremesa London",
  description = "Sobremesa London — desde 2026. Más soon.",
  themeColor = "#000000",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!--
      viewport-fit=cover: without it Safari lays the document out *inside* the
      safe area on a notched phone, and a full-bleed photograph stops short of
      the status bar and the home indicator — the black bands top and bottom.
      With it the page owns the whole screen and the insets come back as
      env(safe-area-inset-*), which the chrome and the reel's anchor pay back
      to keep type clear of the notch. See SiteHeader.astro / IssueScroller.astro.
    -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="description" content={description} />

    <!--
      The two strips a full-bleed page cannot reach.

      iOS Safari will not let a page paint behind the status bar, or behind its
      own toolbar. It *tints* those strips instead — from this meta, or, if it
      is absent, from the page background. The background here is #000
      (global.css), which is why the reel arrived on a phone with a black band
      above and below the photograph however far the cover was made to overhang.

      So the strip is told what colour the top of the current cover is, and it
      stops reading as a band. src/scripts/reel.ts rewrites this as the reel
      moves; the value rendered here is the cover the page opens on, so the
      first paint is already right. Colours come from scripts/cover-colors.mjs.
    -->
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!--
      Fonts: Geist (wordmark + labels), Kapakana (script "london") and
      UnifrakturCook — the blackletter the 018 cover sets its number in.
      Vitor, the other one-off face (010), is self-hosted; see global.css.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;700;900&family=Kapakana&family=UnifrakturCook:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-black text-pink antialiased">
    <slot />
  </body>
</html>
