---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { bindingFor } from "../../data/bindings";
import COVER_COLORS from "../../data/cover-colors.json";
import { DEFAULTS } from "../../scripts/reel-tuning";

/**
 * Issue reel — Figma nodes 52:194 / 53:269 / 53:324.
 *
 * The three canvases were drawn against 027–029; this renders the whole
 * archive, newest first, off the `issues` collection scraped from Substack.
 * De-selected rows are always white / soft-light; the selected treatment
 * (accent + blend + display face) comes from src/data/bindings.ts, which is
 * read off the Figma cover board.
 */

/**
 * The covers, keyed by issue number from the filename. Globbed rather than
 * imported one by one — there are 27 of them and the set grows every Thursday.
 */
const COVERS = Object.fromEntries(
  Object.entries(
    import.meta.glob<{ default: ImageMetadata }>("../../assets/covers/*.{png,jpg,jpeg}", {
      eager: true,
    }),
  ).map(([path, mod]) => [path.match(/(\d{3})\.\w+$/)![1], mod.default]),
);

/**
 * 002 and 003 never got their own photograph — the newsletter reused 001's.
 * 000 has no cover at all, so it falls through to flat black.
 */
const COVER_ALIASES: Record<string, string> = { "002": "001", "003": "001" };

const ALTS: Record<string, string> = {
  "027": "Mesa de madera con restos de comida callejera entre food trucks al atardecer",
  "028": "Vestuario de fútbol tras la celebración, con cajas de pizza y confeti",
  "029": "Mesa de comedor recién terminada en una extensión acristalada londinense",
};

const entries = (await getCollection("issues")).sort((a, b) =>
  b.data.number.localeCompare(a.data.number),
);

const issues = await Promise.all(
  entries.map(async ({ data }) => {
    const cover = COVERS[COVER_ALIASES[data.number] ?? data.number];
    const optimised = cover
      ? await getImage({
          src: cover,
          widths: [1280, 1920, 2560],
          sizes: "100vw",
          quality: 78,
          format: "webp",
        })
      : null;

    const binding = bindingFor(data.number);

    return {
      number: data.number,
      /*
        The average colour of the top edge of this cover, for the strip Safari
        paints behind the status bar. Generated by scripts/cover-colors.mjs;
        see the theme-color meta in Layout.astro for why it exists. 000 has no
        photograph, so it keeps the page's own black.
      */
      tint: (COVER_COLORS as Record<string, string>)[data.number] ?? "#000000",
      title: data.title,
      src: optimised?.src ?? null,
      srcset: optimised?.srcSet.attribute || null,
      alt: ALTS[data.number] ?? `Portada del número ${data.number} — ${data.title}`,
      accent: binding.accent,
      opacity: binding.opacity ?? 1,
      face: binding.face ?? null,
      // The blends assume a photograph underneath. Over the flat black of a
      // coverless issue, hard-light drops the green channel and renders the
      // orange as pure red — so paint the accent straight.
      blend: optimised ? binding.blend : "normal",
    };
  }),
);
---

{/*
  --step is the gearing: px of scroll per issue. Rendered from the same
  DEFAULTS the script reads, so the spacers are the right height on the first
  frame; reel.ts rewrites it whenever the tuner moves the slider.
*/}
<div class="reel" data-reel style={`--step:${DEFAULTS.travel}`}>
  <!--
    Everything that paints lives inside this stage: it is the stacking context
    the titles blend against. Nothing between the covers and the rows may
    create its own (no transform, opacity or filter on `.rows` / `.row`) or
    mix-blend-mode would blend against transparency instead of the photo.
  -->
  <div class="stage">
    {
      /*
        Thirty full-bleed covers cannot all be in the document at once: they sit
        inside a fixed, on-screen container, so `loading="lazy"` would not hold
        a single one back. The URLs ride in data-* and the scroll handler
        promotes them to real attributes for the issues either side of the
        current one — see mountNear().
      */
      issues.map((issue, i) => (
        <div class="bg" data-bg data-tint={issue.tint} data-nocover={issue.src ? undefined : ""}>
          {issue.src && (
            <img
              src={i === 0 ? issue.src : undefined}
              srcset={i === 0 ? issue.srcset : undefined}
              data-src={issue.src}
              data-srcset={issue.srcset}
              sizes="100vw"
              alt={issue.alt}
              decoding="async"
              fetchpriority={i === 0 ? "high" : "auto"}
            />
          )}
        </div>
      ))
    }

    <ol class="rows">
      {
        issues.map((issue, i) => (
          <li
            class="row"
            data-row
            data-number={issue.number}
            data-face={issue.face}
            style={`--accent:${issue.accent};--blend:${issue.blend};--live-max:${issue.opacity}`}
          >
            {/* De-selected layer: white, soft light. Fades out as the row snaps in. */}
            <span class="ink idle" aria-hidden="true">
              <span class="num">{issue.number}</span>
              <span class="ttl">{issue.title}</span>
            </span>
            {/* Selected layer: issue accent + its blend mode, faded in on top. */}
            <span class="ink live">
              <span class="num">{issue.number}</span>
              <span class="ttl">{issue.title}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>

  {/*
    Scroll driver: one --step-tall spacer per issue. These are the only snap
    targets on the page, and they are static, so 029 always lands at 0. The
    magnet is off by default — it truncates a flick just as the momentum gets
    interesting — but the alignment stays for the modes that switch it on.
  */}
  {issues.map((issue) => <section class="snap" aria-hidden="true" data-snap={issue.number} />)}
</div>

<style>
  .reel {
    /*
      One unit = 1/100th of the 1920×1080 canvas height. Bounded by width as
      well (0.5625vw = 1svh at 16:9) so a window narrower than 16:9 scales the
      whole composition down instead of shoving the titles off the right edge.
    */
    --u: min(1svh, 0.5625vw);

    --row-h: calc(10.6296 * var(--u)); /* 114.8px */
    --pad-l: calc(6.6667 * var(--u)); /* 72px   */
    --gap: calc(0.463 * var(--u)); /*  5px   */
    --num-w: calc(10.37 * var(--u)); /* 112px  */

    /*
      The type is a separate scale from the row it sits in. On the 16:9 canvas
      the two are welded together — the title's leading *is* the row height, so
      the type fills it edge to edge. A portrait phone has to break that weld
      (see the narrow-viewport block at the bottom of this file): the row wants
      to be a readable fraction of a tall screen, the title wants to be a
      readable fraction of a narrow one, and those are no longer the same
      number.
    */
    --num-size: calc(4.0509 * var(--u)); /* 43.75px */
    --num-lh: calc(3.5648 * var(--u)); /* 38.5px  */
    --ttl-size: calc(12.963 * var(--u)); /* 140px   */
    --ttl-lh: var(--row-h); /* 114.8px */
    --ink-align: flex-start;

    /* Snapped row sits flush with the bottom edge (Figma: top 963 of 1080). */
    --anchor: calc(100svh - var(--row-h) - 0.204 * var(--u));

    /*
      How far the photograph is pushed past the viewport on every edge. Zero on
      a desktop window, where the viewport is a number the browser and the page
      agree on; the phone block at the bottom of this file turns it on.
    */
    --bleed: 0px;
    /*
      The bottom wants its own number. /probe on a real iPhone came back cyan
      at the top and magenta at the bottom: the fixed stage reaches the top
      edge on a 41px overhang, and falls short at the bottom by more than that
      — Safari's floating toolbar sits in a strip that 100lvh does not count.
    */
    --bleed-b: 0px;

    --p: 0; /* scroll position, in issues */
    --step: 120; /* px of scroll per issue — the inline style is the real one */

    /*
      The spacers stop at the top of the last issue, but scrolling *to* it
      needs a viewport of room underneath. At the old gearing the spacer was
      that viewport, so this was zero; at 120px it is the missing 780, and
      without it the archive simply ends six issues early.

      Measured against the LARGE viewport, because the runway has to be long
      enough at the viewport's biggest. A mobile toolbar retracts on the first
      scroll and takes ~80px of document height with it; against 100svh the
      runway came up exactly that much short and 000 — the last issue in the
      archive — could not be reached on a phone at all.
    */
    padding-bottom: max(0px, calc(100vh - var(--step) * 1px));
    padding-bottom: max(0px, calc(100lvh - var(--step) * 1px));
  }

  /*
    Fixed, not sticky, and deliberately NOT a snap target. A sticky element's
    snap area travels with the scroll once it is stuck, so it offers a valid
    snap position wherever you happen to stop — which stranded the scroll
    half-way between 029 and 028 and dragged scrollTo(0) back down to 028.
    Out of flow, the spacers below are the only snap targets: 0, 1×vh, 2×vh.
  */
  .stage {
    position: fixed;
    left: 0;
    width: 100%;

    /*
      The photograph is sized to the LARGE viewport and the rows are anchored
      against the small one — they are two different jobs and they want two
      different heights.

      A mobile browser's toolbar retracts on the first scroll and the visible
      viewport grows by ~80px. At 100svh (the height *with* the toolbar) the
      fixed stage keeps its short size and that 80px opens as a black band
      under the cover. 100lvh always fills; the surplus simply sits behind the
      toolbar while it is there. 100dvh would also fill, but it re-measures
      continuously and would re-raster a full-screen photograph all through
      the retraction.
    */
    height: 100vh; /* pre-svh Safari, where 100vh already is the large one */
    height: 100lvh;

    /*
      And on top of that, the bleed. The stage is the clipper — `overflow:
      hidden` here is what draws the edge of the photograph — so an overshoot
      has to be applied to *this* box, not to .bg inside it, or it is simply
      clipped back to the same rectangle.

      Pulling the top up by --bleed and adding it back twice over to the height
      leaves the cover overhanging every edge by that much. It is insurance,
      not composition: whatever the browser and the page disagree about — a
      safe-area inset, a toolbar mid-retraction, a rounded corner, an lvh that
      lands a few px short — is absorbed by the overhang instead of opening as
      black. The rows pay the shift back through --anchor.
    */
    top: calc(-1 * var(--bleed));
    height: calc(100vh + var(--bleed) + var(--bleed-b));
    height: calc(100lvh + var(--bleed) + var(--bleed-b));

    overflow: hidden;
    background: #000;
  }

  .bg {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  /*
    Covers stack: each one fades in *over* the last, which stays opaque
    underneath. So an issue without a cover (000 shipped without one) has to
    paint black itself, or the issue above it stays visible through the gap.
  */
  .bg[data-nocover] {
    background: #000;
  }

  .bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .rows {
    position: absolute;
    top: calc(var(--anchor) - var(--p) * var(--row-h));
    right: 0;
    left: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    height: var(--row-h);
    overflow: hidden; /* Figma: overflow-clip per row */
    cursor: pointer;
  }

  .ink {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: var(--ink-align);
    gap: var(--gap);
    padding-left: var(--pad-l);
    font-family: var(--font-display);
    font-weight: 900; /* Geist UltraBlack */
    text-transform: uppercase;
    white-space: nowrap;
  }

  .num {
    flex: none;
    width: var(--num-w);
    font-size: var(--num-size);
    line-height: var(--num-lh);
    letter-spacing: -0.045em; /* -1.969px */
  }

  /*
    Two covers set their number in something other than Geist, and the reel
    follows: Vitor's Visigothic digits on 010, UnifrakturCook's blackletter on
    018. Both are display faces drawn on a wide body — Geist's -0.045em tracking
    collapses them, so it is released here.
  */
  .row[data-face] .num {
    letter-spacing: 0;
  }

  .row[data-face="vitor"] .num {
    font-family: var(--font-vitor);
    font-weight: 400;
  }

  .row[data-face="blackletter"] .num {
    font-family: var(--font-blackletter);
    font-weight: 700;
  }

  .ttl {
    font-size: var(--ttl-size);
    line-height: var(--ttl-lh);
    letter-spacing: -0.045em; /* -6.3px  */
  }

  .idle {
    color: #fff;
    mix-blend-mode: soft-light;
    opacity: var(--idle, 1);
  }

  /*
    A blended layer costs a read of the photograph behind it whatever its
    opacity, and at any moment most of the archive is sitting at 3% white —
    where soft-light and plain white land within about five levels of each
    other, on the darkest cover in the set. reel.ts flags those rows and they
    come off the blend: five blended layers a frame instead of thirty.
  */
  .row[data-ghost] .idle {
    mix-blend-mode: normal;
  }

  .live {
    color: var(--accent);
    mix-blend-mode: var(--blend);
    /* --live-max carries the layer opacity the board sets (024 sits at 0.7). */
    opacity: calc(var(--live, 0) * var(--live-max, 1));
  }

  .snap {
    height: calc(var(--step) * 1px);
    scroll-snap-align: start;
  }

  /*
    The phone.

    `--u` is bounded by width, so on a 375pt screen it collapses to 2.1px and
    the whole 16:9 composition arrives at a quarter scale: a 22px row on an
    812pt screen. That is what put the weight off. One issue of travel moved
    the reel 2.8% of the screen while it cost 120px of thumb — a 5:1 winch,
    where the desktop gearing is 1:1 — and it is why the scroll read as heavy
    and unresponsive rather than as a reel with momentum.

    So the row goes back to being a real fraction of the screen (7svh, ~57px)
    and the title is sized off the width instead of off the row. The two are
    no longer the same measurement, so the ink hangs from the bottom of the row
    rather than filling it. The matching gearing lives in reel-tuning.ts —
    MOBILE.travel is set against this row height and the two have to move
    together.
  */
  @media (max-width: 48rem) {
    .reel {
      --row-h: clamp(2.8rem, 7svh, 4rem);
      --pad-l: max(1rem, 4.3vw + env(safe-area-inset-left, 0px));
      --gap: 0.35rem;
      --num-w: 2.15rem;

      --num-size: 0.7rem;
      --num-lh: 0.85rem;
      --ttl-size: clamp(1.5rem, 8.4vw, 2.6rem);
      --ttl-lh: 1;
      --ink-align: flex-end;

      /*
        The phone is where the viewport is a negotiation rather than a number —
        a toolbar mid-retraction, a rounded corner, an lvh that lands a few px
        short — so the cover overhangs rather than trusting the measurement.

        Sized to clear the insets iOS actually asks for (59px at the top of the
        tallest phone, 34 at the bottom) and no further. It started at 8svh,
        when the black bands were still thought to be a safe-area problem; they
        were not — see the theme-color meta in Layout.astro — so the overhang
        went back to what its own job needs. Every px of it is a px more
        photograph to raster and a tighter crop on an already extreme one.
      */
      /*
        No overhang. It was insurance against the cover stopping short of the
        screen, and the probe proved it cannot buy that: a fixed element is
        clipped to the layout viewport, so pulling it up or making it taller
        moves nothing into the 120px the viewport units do not admit to. The
        canvas covers those strips instead — see the html rule in global.css.
      */
      --bleed: 0px;
      --bleed-b: 0px;

      /*
        Clear of the browser's own bottom toolbar, which overlays the page, and
        now of the home indicator too — viewport-fit=cover (see Layout.astro)
        hands the page that strip and the titles must not sit in it. The
        --bleed term puts back the shift the stage took: the anchor is measured
        from the top of the *viewport*, the stage now starts above it.
      */
      --anchor: calc(
        var(--bleed) + 100svh - var(--row-h) - 0.75rem -
          env(safe-area-inset-bottom, 0px)
      );
    }
  }
</style>

<script>
  import { mountReel } from "../../scripts/reel";

  const reel = document.querySelector<HTMLElement>("[data-reel]");
  if (reel) mountReel(reel);
</script>
