---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { bindingFor } from "../../data/bindings";
import { DEFAULTS } from "../../scripts/reel-tuning";

/**
 * Issue reel — Figma nodes 52:194 / 53:269 / 53:324.
 *
 * The three canvases were drawn against 027–029; this renders the whole
 * archive, newest first, off the `issues` collection scraped from Substack.
 * De-selected rows are always white / soft-light; the selected treatment
 * (accent + blend + display face) comes from src/data/bindings.ts, which is
 * read off the Figma cover board.
 */

/**
 * The covers, keyed by issue number from the filename. Globbed rather than
 * imported one by one — there are 27 of them and the set grows every Thursday.
 */
const COVERS = Object.fromEntries(
  Object.entries(
    import.meta.glob<{ default: ImageMetadata }>("../../assets/covers/*.{png,jpg,jpeg}", {
      eager: true,
    }),
  ).map(([path, mod]) => [path.match(/(\d{3})\.\w+$/)![1], mod.default]),
);

/**
 * 002 and 003 never got their own photograph — the newsletter reused 001's.
 * 000 has no cover at all, so it falls through to flat black.
 */
const COVER_ALIASES: Record<string, string> = { "002": "001", "003": "001" };

const ALTS: Record<string, string> = {
  "027": "Mesa de madera con restos de comida callejera entre food trucks al atardecer",
  "028": "Vestuario de fútbol tras la celebración, con cajas de pizza y confeti",
  "029": "Mesa de comedor recién terminada en una extensión acristalada londinense",
};

const entries = (await getCollection("issues")).sort((a, b) =>
  b.data.number.localeCompare(a.data.number),
);

const issues = await Promise.all(
  entries.map(async ({ data }) => {
    const cover = COVERS[COVER_ALIASES[data.number] ?? data.number];
    const optimised = cover
      ? await getImage({
          src: cover,
          widths: [1280, 1920, 2560],
          sizes: "100vw",
          quality: 78,
          format: "webp",
        })
      : null;

    const binding = bindingFor(data.number);

    return {
      number: data.number,
      title: data.title,
      src: optimised?.src ?? null,
      srcset: optimised?.srcSet.attribute || null,
      alt: ALTS[data.number] ?? `Portada del número ${data.number} — ${data.title}`,
      accent: binding.accent,
      opacity: binding.opacity ?? 1,
      face: binding.face ?? null,
      // The blends assume a photograph underneath. Over the flat black of a
      // coverless issue, hard-light drops the green channel and renders the
      // orange as pure red — so paint the accent straight.
      blend: optimised ? binding.blend : "normal",
    };
  }),
);
---

{/*
  --step is the gearing: px of scroll per issue. Rendered from the same
  DEFAULTS the script reads, so the spacers are the right height on the first
  frame; reel.ts rewrites it whenever the tuner moves the slider.
*/}
<div class="reel" data-reel style={`--step:${DEFAULTS.travel}`}>
  <!--
    Everything that paints lives inside this stage: it is the stacking context
    the titles blend against. Nothing between the covers and the rows may
    create its own (no transform, opacity or filter on `.rows` / `.row`) or
    mix-blend-mode would blend against transparency instead of the photo.
  -->
  <div class="stage">
    {
      /*
        Thirty full-bleed covers cannot all be in the document at once: they sit
        inside a fixed, on-screen container, so `loading="lazy"` would not hold
        a single one back. The URLs ride in data-* and the scroll handler
        promotes them to real attributes for the issues either side of the
        current one — see mountNear().
      */
      issues.map((issue, i) => (
        <div class="bg" data-bg data-nocover={issue.src ? undefined : ""}>
          {issue.src && (
            <img
              src={i === 0 ? issue.src : undefined}
              srcset={i === 0 ? issue.srcset : undefined}
              data-src={issue.src}
              data-srcset={issue.srcset}
              sizes="100vw"
              alt={issue.alt}
              decoding="async"
              fetchpriority={i === 0 ? "high" : "auto"}
            />
          )}
        </div>
      ))
    }

    <ol class="rows">
      {
        issues.map((issue, i) => (
          <li
            class="row"
            data-row
            data-number={issue.number}
            data-face={issue.face}
            style={`--accent:${issue.accent};--blend:${issue.blend};--live-max:${issue.opacity}`}
          >
            {/* De-selected layer: white, soft light. Fades out as the row snaps in. */}
            <span class="ink idle" aria-hidden="true">
              <span class="num">{issue.number}</span>
              <span class="ttl">{issue.title}</span>
            </span>
            {/* Selected layer: issue accent + its blend mode, faded in on top. */}
            <span class="ink live">
              <span class="num">{issue.number}</span>
              <span class="ttl">{issue.title}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>

  {/*
    Scroll driver: one --step-tall spacer per issue. These are the only snap
    targets on the page, and they are static, so 029 always lands at 0. The
    magnet is off by default — it truncates a flick just as the momentum gets
    interesting — but the alignment stays for the modes that switch it on.
  */}
  {issues.map((issue) => <section class="snap" aria-hidden="true" data-snap={issue.number} />)}
</div>

<style>
  .reel {
    /*
      One unit = 1/100th of the 1920×1080 canvas height. Bounded by width as
      well (0.5625vw = 1svh at 16:9) so a window narrower than 16:9 scales the
      whole composition down instead of shoving the titles off the right edge.
    */
    --u: min(1svh, 0.5625vw);

    --row-h: calc(10.6296 * var(--u)); /* 114.8px */
    --pad-l: calc(6.6667 * var(--u)); /* 72px   */
    --gap: calc(0.463 * var(--u)); /*  5px   */
    --num-w: calc(10.37 * var(--u)); /* 112px  */

    /* Snapped row sits flush with the bottom edge (Figma: top 963 of 1080). */
    --anchor: calc(100svh - var(--row-h) - 0.204 * var(--u));

    --p: 0; /* scroll position, in issues */
    --step: 120; /* px of scroll per issue — the inline style is the real one */

    /*
      The spacers stop at the top of the last issue, but scrolling *to* it
      needs a viewport of room underneath. At the old gearing the spacer was
      that viewport, so this was zero; at 120px it is the missing 780, and
      without it the archive simply ends six issues early.
    */
    padding-bottom: max(0px, calc(100svh - var(--step) * 1px));
  }

  /*
    Fixed, not sticky, and deliberately NOT a snap target. A sticky element's
    snap area travels with the scroll once it is stuck, so it offers a valid
    snap position wherever you happen to stop — which stranded the scroll
    half-way between 029 and 028 and dragged scrollTo(0) back down to 028.
    Out of flow, the spacers below are the only snap targets: 0, 1×vh, 2×vh.
  */
  .stage {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: #000;
  }

  .bg {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  /*
    Covers stack: each one fades in *over* the last, which stays opaque
    underneath. So an issue without a cover (000 shipped without one) has to
    paint black itself, or the issue above it stays visible through the gap.
  */
  .bg[data-nocover] {
    background: #000;
  }

  .bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .rows {
    position: absolute;
    top: calc(var(--anchor) - var(--p) * var(--row-h));
    right: 0;
    left: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    height: var(--row-h);
    overflow: hidden; /* Figma: overflow-clip per row */
    cursor: pointer;
  }

  .ink {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
    padding-left: var(--pad-l);
    font-family: var(--font-display);
    font-weight: 900; /* Geist UltraBlack */
    text-transform: uppercase;
    white-space: nowrap;
  }

  .num {
    flex: none;
    width: var(--num-w);
    font-size: calc(4.0509 * var(--u)); /* 43.75px */
    line-height: calc(3.5648 * var(--u)); /* 38.5px  */
    letter-spacing: -0.045em; /* -1.969px */
  }

  /*
    Two covers set their number in something other than Geist, and the reel
    follows: Vitor's Visigothic digits on 010, UnifrakturCook's blackletter on
    018. Both are display faces drawn on a wide body — Geist's -0.045em tracking
    collapses them, so it is released here.
  */
  .row[data-face] .num {
    letter-spacing: 0;
  }

  .row[data-face="vitor"] .num {
    font-family: var(--font-vitor);
    font-weight: 400;
  }

  .row[data-face="blackletter"] .num {
    font-family: var(--font-blackletter);
    font-weight: 700;
  }

  .ttl {
    font-size: calc(12.963 * var(--u)); /* 140px  */
    line-height: var(--row-h); /* 114.8px */
    letter-spacing: -0.045em; /* -6.3px  */
  }

  .idle {
    color: #fff;
    mix-blend-mode: soft-light;
    opacity: var(--idle, 1);
  }

  .live {
    color: var(--accent);
    mix-blend-mode: var(--blend);
    /* --live-max carries the layer opacity the board sets (024 sits at 0.7). */
    opacity: calc(var(--live, 0) * var(--live-max, 1));
  }

  .snap {
    height: calc(var(--step) * 1px);
    scroll-snap-align: start;
  }
</style>

<script>
  import { mountReel } from "../../scripts/reel";

  const reel = document.querySelector<HTMLElement>("[data-reel]");
  if (reel) mountReel(reel);
</script>
