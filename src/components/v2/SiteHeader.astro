---
/**
 * Virtual header — the one piece of chrome that rides above the reel.
 *
 * The reel's `.stage` is `position: fixed` with `z-index: auto`, so it never
 * opens a stacking context of its own: the covers and the blended rows paint
 * into the root. A plain `z-index` here is therefore enough to sit above every
 * cover, and — because the bar paints *after* the rows — it also stays out of
 * their `mix-blend-mode` backdrop, so the header never tints the titles.
 *
 * Kept under the ScrollTuner's z-index: 100, which is a design tool and should
 * stay reachable on top of everything.
 */
const SUBSTACK = "https://designsobremesa.substack.com";
---

<header class="chrome">
  <!--
    The bar spans the full width so the lockup can be centred on the viewport
    rather than on whatever is left over next to the CTA. Only the two links
    take the pointer — the rest of the strip stays transparent to clicks so the
    reel underneath keeps its own scroll and row hits.
  -->
  <a class="lockup" href="/" aria-label="Sobremesa London — inicio">
    <!--
      Same isolated `plus-lighter` group as the cover lockup: the two words
      blend against each other (brighter where "london" crosses "SOBREMESA")
      but, being isolated, never against the photograph behind them.
    -->
    <span class="mark isolate">
      <span class="grot">SOBREMESA</span>
      <span class="script">london</span>
    </span>
  </a>

  <a class="cta" href={`${SUBSTACK}/subscribe`} target="_blank" rel="noopener">
    SUBSCRIBE
  </a>
</header>

<style>
  .chrome {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 90;

    display: grid;
    /* Three tracks with equal outer columns: the lockup lands on the centre of
       the viewport whatever the CTA measures. */
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: clamp(1.75rem, 4.4svh, 3.1rem) clamp(1rem, 3.5vw, 2.75rem)
      clamp(0.85rem, 2.2svh, 1.6rem);

    /* The strip itself is inert; the links below opt back in. */
    pointer-events: none;
  }

  /*
    Covers are photographs and some of them are bright at the top edge. A short
    scrim under the chrome buys the orange a constant contrast floor
    without reading as a solid bar.
  */
  .chrome::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 165%;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.62) 0%,
      rgb(0 0 0 / 0.32) 42%,
      rgb(0 0 0 / 0) 100%
    );
  }

  .lockup,
  .cta {
    position: relative; /* above the scrim */
    pointer-events: auto;
    text-decoration: none;
  }

  .lockup {
    grid-column: 2;
    display: block;
    color: var(--color-orange);
  }

  .mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .grot {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.3vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    mix-blend-mode: plus-lighter;
  }

  .script {
    margin-top: -0.28em;
    font-family: var(--font-script);
    font-size: clamp(2.15rem, 4.2vw, 3.1rem);
    line-height: 0.8;
    mix-blend-mode: plus-lighter;
  }

  .cta {
    grid-column: 3;
    justify-self: end;

    display: inline-flex;
    align-items: center;
    padding: 0.5em 1.05em;
    border: 1px solid var(--color-orange);
    border-radius: 999px;

    font-family: var(--font-display);
    font-size: clamp(0.62rem, 0.95vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-orange);
    background: rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);

    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }

  .cta:hover,
  .cta:focus-visible {
    color: #000;
    background: var(--color-orange);
  }

  /*
    The pill is small, but a backdrop-filter is not: it isolates its patch of
    the page and re-blurs it every time what is behind it changes — and what is
    behind it is a full-screen photograph that moves for the whole length of a
    flick. On a phone that is a blur pass per frame for a 110×32 pill. The
    background alpha does the same job of holding the orange off a bright cover,
    so the blur comes off and the black goes up.
  */
  @media (pointer: coarse), (max-width: 48rem) {
    .cta {
      background: rgb(0 0 0 / 0.55);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* Narrow viewports: the lockup would collide with the CTA long before the
     clamps bottom out, so the script line — the tall half — is dropped and the
     grot alone carries the mark. */
  @media (max-width: 30rem) {
    .script {
      display: none;
    }

    .grot {
      font-size: 1.05rem;
    }

    .cta {
      padding: 0.45em 0.8em;
      letter-spacing: 0.08em;
    }
  }
</style>
