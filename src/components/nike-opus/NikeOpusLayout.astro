---
// /nike-concept-opus — own shell. The After Dark Tour grammar inverted onto paper:
// warm paper ground, umber ink, the four sparks held back for interaction only.
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sobremesa Tour ©2026 — every issue of Design Sobremesa, one stop at a time.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700;900&family=Kapakana&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Neutrals lifted from the cover photography, promoted to the system */
    --paper: #ece5d6;
    --paper-deep: #e2d8c4;
    --paper-deeper: #d6cab2;
    --ink: #241d13;
    --ink-soft: #534530;
    --ink-faint: #8a7a5e;
    --rule: rgba(83, 69, 48, 0.22);

    /* The four Figma tokens. Rationed: interaction only. */
    --pink: #ff006f;
    --aqua: #89ffe4;
    --fire: #ff8000;
    --sea: #0051ff;

    --grotesque: "Geist", system-ui, -apple-system, sans-serif;
    --script: "Kapakana", cursive;
  }

  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    -webkit-text-size-adjust: 100%;
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--grotesque);
    font-size: 1rem;
    line-height: 1.5;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    min-height: 100%;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ::selection {
    background: var(--pink);
    color: var(--paper);
  }

  :focus-visible {
    outline: 2px solid var(--sea);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
