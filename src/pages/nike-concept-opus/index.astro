    }
    .row {
      margin-left: 0;
    }
    .row-tail {
      display: none;
    }
    .row-date {
      display: none;
    }
    .map {
      aspect-ratio: 3 / 4;
    }
    .map-table {
      inset: 6% 10%;
    }
    .spot-title {
      display: none;
    }
    .foot-index ul {
      columns: 1;
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Staggered reveal. Delay is assigned per intersecting batch so a fast scroll
  // never leaves a row waiting on a queue built for a slow one.
  const revealables = document.querySelectorAll<HTMLElement>(".reveal");
  if (reduced || !("IntersectionObserver" in window)) {
    revealables.forEach((el) => el.classList.add("in"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        let n = 0;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.style.transitionDelay = `${n * 70}ms`;
          el.classList.add("in");
          io.unobserve(el);
          n++;
        }
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.08 },
    );
    revealables.forEach((el) => io.observe(el));
  }

  // Nav state + hero parallax, both off one rAF-throttled scroll listener.
  const nav = document.getElementById("nav");
  const parallax = document.querySelector<HTMLElement>("[data-parallax]");
  let ticking = false;

  const onScroll = () => {
    const y = window.scrollY;
    nav?.classList.toggle("scrolled", y > 40);
    if (parallax && !reduced) {
      parallax.style.transform = `translate3d(0, ${(y * -0.12).toFixed(2)}px, 0)`;
    }
    ticking = false;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(onScroll);
    },
    { passive: true },
  );
  onScroll();
</script>
