  .spot-right .spot-title {
    left: calc(100% + 0.5rem);
  }
  .spot-left .spot-title {
    right: calc(100% + 0.5rem);
  }
  .spot:hover .spot-dot,
  .spot:focus-visible .spot-dot {
    background: var(--c);
    border-color: var(--c);
    transform: scale(1.5);
    box-shadow: 0 0 0 5px rgba(36, 29, 19, 0.08);
